{"ts":"2026-10-11T12:29:29.177Z","level":"info","event":"tool_call","tool":"project_helper","requestId":"b6cbd5e1-192a-42d8-a037-cc4185db598b","status":"success","durationMs":1,"input":{"action":"read_file","path":"src/tools/docsContext.js","startLine":140},"output":{"action":"read_file","path":"src/tools/docsContext.js","language":"javascript","totalLines":172,"startLine":140,"endLine":172,"content":"    // Секция включает вложенные подзаголовки до следующего заголовка того же или более высокого уровня.\n    const { level } = sections[idx];\n    const end = sections.findIndex((s, i) => i > idx && s.level > 0 && s.level <= level);\n    content = sections\n      .slice(idx, end === -1 ? undefined : end)\n      .map((s) => s.content)\n      .join('\\n\\n');\n    matchedSection = sections[idx].heading;\n  }\n\n  const clipped = clip(content);\n  return {\n    action: 'read',\n    path: relative,\n    title: extractTitle(text, relative),\n    section: matchedSection,\n    content: clipped.text,\n    truncated: clipped.truncated,\n  };\n}\n\nexport const docsContextTool = {\n  name: 'docs_context',\n  title: 'База знаний по 3D-печати',\n  description:\n    'Контекст из базы знаний по FDM-печати (папка docs/): филаменты (PLA, PETG, ABS/ASA, TPU, PC, PA/композиты, поддержки), ' +\n    'принтеры (Anycubic Kobra X, Bambu Lab P1S, Creality K2), сушка, адгезия, дефекты. ' +\n    'Сначала используйте search или list, затем read для нужного документа/секции.',\n  inputSchema,\n  annotations: { readOnlyHint: true, openWorldHint: false },\n  handler: (args) => ({ list, search, read })[args.action](args),\n};\n","truncated":false}}
{"ts":"2026-10-11T12:29:29.184Z","level":"info","event":"tool_call","tool":"project_helper","requestId":"ac09b03a-4c3e-4fdb-9830-1a0e05bbf02b","status":"success","durationMs":1,"input":{"action":"read_file","path":"src/core/logger.js"},"output":{"action":"read_file","path":"src/core/logger.js","language":"javascript","totalLines":66,"startLine":1,"endLine":66,"content":"import fs from 'node:fs';\nimport path from 'node:path';\nimport { LIMITS, PROJECT_ROOT } from '../config.js';\n\nconst LEVELS = { debug: 10, info: 20, warn: 30, error: 40 };\n\n/** Обрезает длинные строки и глубокие структуры, чтобы лог оставался читаемым. */\nexport function truncateForLog(value, maxChars = LIMITS.maxLogValueChars, depth = 0) {\n  if (typeof value === 'string') {\n    return value.length > maxChars ? `${value.slice(0, maxChars)}… [+${value.length - maxChars} chars]` : value;\n  }\n  if (value === null || typeof value !== 'object') return value;\n  if (depth > 6) return '[depth limit]';\n  if (Array.isArray(value)) return value.map((v) => truncateForLog(v, maxChars, depth + 1));\n  return Object.fromEntries(Object.entries(value).map(([k, v]) => [k, truncateForLog(v, maxChars, depth + 1)]));\n}\n\n/**\n * Логгер в формате JSON Lines.\n * stdout занят протоколом MCP (stdio), поэтому вывод идёт в stderr\n * и, если не отключено через MCP_LOG_FILE=off, в файл logs/mcp-server.log.\n */\nexport function createLogger({\n  level = process.env.MCP_LOG_LEVEL ?? 'info',\n  file = process.env.MCP_LOG_FILE ?? path.join(PROJECT_ROOT, 'logs', 'mcp-server.log'),\n  stream = process.stderr,\n} = {}) {\n  const threshold = LEVELS[level] ?? LEVELS.info;\n  let fileStream = null;\n  if (file && file !== 'off') {\n    fs.mkdirSync(path.dirname(file), { recursive: true });\n    fileStream = fs.createWriteStream(file, { flags: 'a' });\n  }\n\n  function write(lvl, event, fields = {}) {\n    if (LEVELS[lvl] < threshold) return;\n    const line = JSON.stringify({ ts: new Date().toISOString(), level: lvl, event, ...truncateForLog(fields) });\n    stream?.write(`${line}\\n`);\n    fileStream?.write(`${line}\\n`);\n  }\n\n  return {\n    debug: (event, fields) => write('debug', event, fields),\n    info: (event, fields) => write('info', event, fields),\n    warn: (event, fields) => write('warn', event, fields),\n    error: (event, fields) => write('error', event, fields),\n\n    /** Запись о вызове тула: имя, вход, выход, с… [+425 chars]","truncated":false}}
