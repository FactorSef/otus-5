ools.map((t) => ({\n      name: t.name,\n      title: t.title,\n      description: t.description,\n      inputSchema: t.inputSchemaJson,\n      outputSchema: RESPONSE_OUTPUT_JSON_SCHEMA,\n      annotations: t.annotations,\n    })),\n  }));\n\n  server.setRequestHandler(CallToolRequestSchema, async (request) => {\n    const { name, arguments: input = {} } = request.params;\n    return toCallToolResult(await r… [+1728 chars]","truncated":false}}
{"ts":"2026-10-11T11:22:35.922Z","level":"info","event":"tool_call","tool":"project_helper","requestId":"749659e7-1324-4a48-b2a6-3d9bcb88dd50","status":"success","durationMs":2,"input":{"action":"read_file","path":"src/index.js"},"output":{"action":"read_file","path":"src/index.js","language":"javascript","totalLines":24,"startLine":1,"endLine":24,"content":"#!/usr/bin/env node\nimport { StdioServerTransport } from '@modelcontextprotocol/sdk/server/stdio.js';\nimport { PROJECT_ROOT, SERVER_INFO } from './config.js';\nimport { createServer } from './server.js';\n\nconst { server, logger, tools } = createServer();\n\nasync function shutdown(signal) {\n  logger.info('server_stop', { signal });\n  await server.close().catch(() => {});\n  logger.close();\n  process.exit(0);\n}\nprocess.on('SIGINT', () => shutdown('SIGINT'));\nprocess.on('SIGTERM', () => shutdown('SIGTERM'));\n\ntry {\n  await server.connect(new StdioServerTransport());\n  logger.info('server_start', { ...SERVER_INFO, projectRoot: PROJECT_ROOT, tools: tools.map((t) => t.name) });\n} catch (err) {\n  logger.error('server_start_failed', { message: err.message, stack: err.stack });\n  process.exit(1);\n}\n","truncated":false}}
