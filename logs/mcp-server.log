{"ts":"2026-10-11T12:29:22.397Z","level":"info","event":"tool_call","tool":"project_helper","requestId":"9513ee57-e559-4905-aeb1-9fafe8b21b93","status":"success","durationMs":2,"input":{"action":"read_file","path":"src/core/response.js"},"output":{"action":"read_file","path":"src/core/response.js","language":"javascript","totalLines":69,"startLine":1,"endLine":69,"content":"import { z } from 'zod';\nimport { RESPONSE_SCHEMA_VERSION } from '../config.js';\nimport { ErrorCode } from './errors.js';\n\n/**\n * Единый конверт ответа для всех тулов.\n *\n * {\n *   schemaVersion: \"1.0\",\n *   tool:      \"docs_context\",\n *   requestId: \"uuid\",\n *   status:    \"success\" | \"error\",\n *   data:      { ... } | null,      // null при ошибке\n *   error:     { code, message, details? } | null,   // null при успехе\n *   meta:      { timestamp, durationMs }\n * }\n */\nexport const ResponseEnvelopeSchema = z\n  .object({\n    schemaVersion: z.literal(RESPONSE_SCHEMA_VERSION),\n    tool: z.string(),\n    requestId: z.string(),\n    status: z.enum(['success', 'error']),\n    data: z.record(z.string(), z.unknown()).nullable(),\n    error: z\n      .object({\n        code: z.enum(Object.values(ErrorCode)),\n        message: z.string(),\n        details: z.unknown().optional(),\n      })\n      .nullable(),\n    meta: z.object({\n      timestamp: z.string(),\n      durationMs: z.number().nonnegative(),\n    }),\n  })\n  .refine((r) => (r.status === 'success' ? r.error === null && r.data !== null : r.error !== null && r.data === null), {\n    message: 'status должен соответствовать заполненности data/error',\n  });\n\nexport const RESPONSE_OUTPUT_JSON_SCHEMA = (() => {\n  const { $schema, ...schema } = z.toJSONSchema(ResponseEnvelopeSchema, { io: 'output' });\n  return schema;\n})();\n\nexport function buildEnvelope({ tool, requestId, startedAt, data = null, error = null }) {\n  return {\n    schemaVersion: RESPONSE_SCHEMA_VERSION,\n    tool,\n    requestId,\n    status: error ? 'error' : 'success',\n    data: error ? null : data,\n    error: error ?? null,\n    meta: {\n      timestamp: new Date(startedAt).toISOString(),\n      durationMs: Date.now() - startedAt,\n    },\n  };\n}\n\n/** Превращает конверт в CallToolResult: JSON в text-контенте + structuredContent. */\nexport function toCallToolResult(envelope) {\n  return {\n    content: [{ type: 'text', text: JSON.stringify(envelope, null, 2) }],\n    structuredCo… [+66 chars]","truncated":false}}
{"ts":"2026-10-11T12:29:26.133Z","level":"info","event":"tool_call","tool":"project_helper","requestId":"49badbcf-f4fd-43a4-9d2d-dc139866071f","status":"success","durationMs":1,"input":{"action":"read_file","path":"src/tools/docsContext.js","endLine":60},"output":{"action":"read_file","path":"src/tools/docsContext.js","language":"javascript","totalLines":172,"startLine":1,"endLine":60,"content":"import path from 'node:path';\nimport { z } from 'zod';\nimport { DOCS_DIR, LIMITS } from '../config.js';\nimport { ErrorCode, ToolError } from '../core/errors.js';\nimport { clip, readTextFile, walk } from '../core/fsUtils.js';\nimport { resolveInside } from '../core/pathGuard.js';\nimport { extractTitle, normalize, parseSections, stem, tokenize } from '../docs/markdown.js';\n\nconst SCOPES = ['all', 'printers', 'filaments', 'guides'];\n\nconst inputSchema = z\n  .object({\n    action: z\n      .enum(['list', 'search', 'read'])\n      .describe('list — оглавление базы; search — поиск по секциям; read — чтение документа или его секции'),\n    query: z.string().min(1).max(200).optional().describe('Поисковый запрос (для action=search), напр. \"PETG P1S адгезия\"'),\n    scope: z.enum(SCOPES).default('all').describe('Раздел базы для list/search'),\n    path: z.string().min(1).max(300).optional().describe('Путь документа относительно docs/ (для action=read), напр. \"filaments/pla.md\"'),\n    section: z\n      .string()\n      .min(1)\n      .max(200)\n      .optional()\n      .describe('Заголовок секции для action=read (поиск по вхождению, без учёта регистра)'),\n    maxResults: z.number().int().min(1).max(LIMITS.maxResults).default(5).describe('Сколько результатов поиска вернуть'),\n  })\n  .strict()\n  .superRefine((v, ctx) => {\n    if (v.action === 'search' && !v.query) ctx.addIssue({ code: 'custom', path: ['query'], message: 'обязателен для action=search' });\n    if (v.action === 'read' && !v.path) ctx.addIssue({ code: 'custom', path: ['path'], message: 'обязателен для action=read' });\n  });\n\nfunction categoryOf(relPath) {\n  const top = relPath.split('/')[0];\n  return SCOPES.includes(top) && relPath.includes('/') ? top : 'root';\n}\n\nasync function loadDocs(scope) {\n  const entries = await walk(DOCS_DIR, { filter: (rel, d) => d.isDirectory() || rel.endsWith('.md') });\n  const docs = [];\n  for (const entry of entries) {\n    if (entry.type !== 'file') continue;\n    const category = categoryOf(entry.… [+526 chars]","truncated":false}}
{"ts":"2026-10-11T12:29:26.160Z","level":"info","event":"tool_call","tool":"project_helper","requestId":"5c06a4ef-2c5c-4c8b-b9d3-30bde770b3e0","status":"success","durationMs":15,"input":{"action":"read_file","path":"src/config.js"},"output":{"action":"read_file","path":"src/config.js","language":"javascript","totalLines":32,"startLine":1,"endLine":32,"content":"import path from 'node:path';\nimport { fileURLToPath } from 'node:url';\n\n// Корень проекта вычисляется от расположения исходников и намеренно\n// не переопределяется через окружение: сервер читает только свою папку.\nexport const PROJECT_ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');\n\nexport const DOCS_DIR = path.join(PROJECT_ROOT, 'docs');\n\nexport const SERVER_INFO = { name: 'printing-kb-mcp', version: '1.0.0' };\n\n// Версия формата ответа. Меняется только при несовместимых изменениях конверта.\nexport const RESPONSE_SCHEMA_VERSION = '1.0';\n\nexport const LIMITS = {\n  maxFileBytes: 256 * 1024,\n  maxContentChars: 20_000,\n  maxResults: 50,\n  maxTreeDepth: 6,\n  maxLogValueChars: 2_000,\n};\n\n// Каталоги и файлы, которые project_helper не показывает и не читает.\n// docs/ обслуживает docs_context, остальное — служебное или чувствительное.\nexport const PROJECT_DENYLIST = {\n  dirs: new Set(['node_modules', '.git', 'logs', 'docs', '.claude']),\n  filePatterns: [/^\\.env(\\..*)?$/i, /\\.(pem|key|p12|pfx)$/i],\n};\n\nexport const SEARCHABLE_CODE_EXTENSIONS = new Set(['.js', '.mjs', '.cjs', '.json', '.md']);\nexport const SEARCH_SKIP_FILES = new Set(['package-lock.json']);\n","truncated":false}}
